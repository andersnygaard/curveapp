{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", ".storybook/*", "vite.config.ts", "vitest.config.ts"]
}
